# Telegram — bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-your-token
# Your numeric chat id (bot only answers this account)
ALLOWED_CHAT_ID=123456789

# Primary RPC (default = public, free)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Helius as automatic fallback when public RPC 429/timeout.
# Dashboard: https://dashboard.helius.dev  → API keys → copy key
HELIUS_API_KEY=
# Optional: full Helius URL if you don't want to use HELIUS_API_KEY
# HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# Optional extra fallback (QuickNode / Triton / etc)
# SOLANA_RPC_FALLBACK_URL=

# Optional DexPaprika key (free keyless works; key raises monthly credits)
DEXPAPRIKA_API_KEY=

# Optional GMGN OpenAPI (best-effort enrichment, never blocks a scan)
GMGN_API_KEY=
GMGN_API_BASE=https://gmgn.ai

# Optional RugCheck (single-token report is keyless)
RUGCHECK_API_KEY=

# Scan cadence
SCAN_CRON=*/5 * * * *
# IANA name: UTC, Asia/Jakarta, Asia/Singapore
# UTC+8 / UTC+7 / WIB also accepted
SCAN_TIMEZONE=Asia/Jakarta

# Discovery
METEORA_DISCOVERY_URL=https://pool-discovery-api.datapi.meteora.ag
METEORA_DLMM_URL=https://dlmm.datapi.meteora.ag
DEXPAPRIKA_URL=https://api.dexpaprika.com
RUGCHECK_URL=https://api.rugcheck.xyz
DEXSCREENER_URL=https://api.dexscreener.com

# How many discovery pages (50 pools each) to pull per cycle
DISCOVERY_MAX_PAGES=2
# Concurrency for DexPaprika / RugCheck enrichment
ENRICH_CONCURRENCY=3
# Concurrency for KOL wallet RPC
KOL_RPC_CONCURRENCY=3
