# Use MOCK=1 to run offline. Keep separate databases for mock, live dry-run and live alerts.
MOCK=0
RADAR_LIVE=0
# RADAR_DB=/srv/screeningLP/whale-radar/data/radar.sqlite

LP_AGENT_API_KEY=
LP_AGENT_RPM=10
JUPITER_API_KEY=
HELIUS_API_KEY=
# Supply a different RPC and optional WebSocket endpoint if needed.
RADAR_RPC_URL=
RADAR_WS_URL=

# Configure an existing dedicated Helius webhook and use its ID to synchronize the watchlist.
HELIUS_WEBHOOK_ID=
HELIUS_WEBHOOK_URL=
HELIUS_WEBHOOK_AUTH=
RADAR_WEBHOOK_PORT=9012

# TELEGRAM_BOT_TOKEN and ALLOWED_CHAT_ID can be inherited from ../.env.
# RADAR_CHAT_ID overrides the scanner destination for Radar.
RADAR_CHAT_ID=
RADAR_WEB_ENABLED=1
RADAR_WEB_PORT=9011
RADAR_DORM_API_KEY=
RADAR_PUBLIC_TELEGRAM=0
RADAR_PUBLIC_URL=
WEB_USER=
# Store a single-quoted bcrypt hash, not the plaintext password.
WEB_PASSWORD=

RADAR_WINDOW_DAYS=30
RADAR_MIN_CLOSED=20
RADAR_MIN_AVG_SOL=5
RADAR_MAX_PROFIT_SHARE=0.6
RADAR_BOT_HOLD_MIN=5
RADAR_BOT_POSITIONS_DAY=40
RADAR_TOP=100
RADAR_CROSS_CHECK=30
RADAR_PNL_TOLERANCE=0.25
RADAR_MIN_POOL_VOLUME=50000
RADAR_MIN_POOL_TVL=10000
RADAR_MIN_POOL_FEES=1
RADAR_MIN_ORGANIC_SCORE=0
RADAR_POOL_PAGES=2
RADAR_POOLS_PER_RUN=20
RADAR_LP_PAGES=1
RADAR_HISTORY_PAGES=100
RADAR_CANDIDATES=250
RADAR_CONCURRENCY=4
RADAR_DISCOVERY_MINUTES=360

RADAR_ALERT_SOL=10
RADAR_BATCH_SECONDS=90
RADAR_TREND_MINUTES=15
RADAR_TREND_MIN_FDV=0
RADAR_TREND_MIN_DAYS=0
RADAR_TREND_MAX_DAYS=3650
RADAR_TREND_FEE_WEIGHT=45
RADAR_TREND_MOMENTUM_WEIGHT=20
RADAR_TREND_LIQUIDITY_WEIGHT=10
RADAR_TREND_AGE_WEIGHT=5
RADAR_TREND_WHALE_WEIGHT=20
RADAR_TREND_RISK_WEIGHT=10
RADAR_STRATEGY_UNIFORM_CV=0.20
RADAR_STRATEGY_CONCENTRATION=1.40
RADAR_LOG_LEVEL=info
